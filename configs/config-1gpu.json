{
  "_comment": "Reference template. The installer resolves the @TOKENS@ to real paths and injects the locally generated API key. Do not put real secrets in this file. Single card: no --pipeline-windows (two-card split only). --pcie-frac 0.35 is this layout's calibration point; re-measure with ./setup.sh --calibrate --no-start per GPU layout. Images (the strata-vision encoder + mmproj, --vision) are on for every profile; --vram-reserve-mib 700 is what the GPU encoder leaves free (upstream's value).",
  "exe": "@STRATA_DIR@/engine/strata",
  "args": [
    "--pack",
    "@DATA_DIR@/packs/iq3_s",
    "--native",
    "@GGUF_DIR@/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--ple-gguf",
    "@GGUF_DIR@/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf",
    "--expert-profile",
    "@STRATA_DIR@/data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "12288",
    "--spec",
    "4",
    "--mtp",
    "@DATA_DIR@/mtp/rt",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--kv-resident",
    "65536",
    "--ple-io",
    "ram",
    "--vram-reserve-mib",
    "700",
    "--conversation-cache-mib",
    "8192",
    "--conversation-cache-slots",
    "4",
    "--conversation-cache-min-free-mib",
    "4096",
    "--pcie-frac",
    "0.35",
    "--spec-min-p",
    "0.70",
    "--vision"
  ],
  "cwd": "@STRATA_DIR@",
  "tokenizer": "@DATA_DIR@/packs/iq3_s/tokenizer",
  "model_name": "qwen3.8-flash-next-iq3_s",
  "log": "@STRATA_DIR@/strata-iq3_s.log",
  "port": 8001,
  "gpu": 0,
  "gpus_asked": true,
  "layer_split": "auto",
  "host": "0.0.0.0",
  "api_key": "<generated-at-install-time>",
  "fit_max_tokens": true,
  "sampling": {
    "temperature": 1.0,
    "top_k": 20,
    "top_p": 0.95,
    "min_p": 0.0,
    "presence_penalty": 0.0,
    "repetition_penalty": 1.0
  },
  "env": {
    "STRATA_IQ_MT_MIN": "1"
  },
  "vision": {
    "exe": "@STRATA_DIR@/engine/strata-vision",
    "mmproj": "@MODELS_DIR@/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
    "model": "@GGUF_DIR@/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "gpu": true,
    "max_tokens": 1024
  }
}
